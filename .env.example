# Copy to .env.local for local development.

# Database. Prototype uses a local SQLite file; production will be PostgreSQL.
DATABASE_URL=file:./data/commons.db

# Secret used to sign session tokens. Generate with: openssl rand -base64 32
# Required in production. A development fallback is used if unset locally.
SESSION_SECRET=

# Identity provider: "mock" for the prototype. "govuk-one-login" is planned.
IDENTITY_PROVIDER=mock
